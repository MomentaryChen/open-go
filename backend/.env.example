DATABASE_URL="postgresql://postgres:postgres@localhost:5432/go_one?schema=public"

# google (default) or duckduckgo. duckduckgo does not launch Chromium.
TRIP_SEARCH_PROVIDER=google

# Set false to hide lodging and ticket partner buttons.
TRIP_AFFILIATE_ENABLED=true

# Set true to finish jobs with a labeled sample itinerary (no search, crawl, or LLM).
TRIP_DEMO_MODE=false

# Public POST /trips. See README for the per-address cap.
TRIP_PUBLIC_CREATE=true
TRIP_CREATE_LIMIT=5
TRIP_CREATE_WINDOW_MS=3600000
