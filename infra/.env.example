# Copy this file to infra/.env and fill in your keys.
# docker compose reads it automatically; .env is gitignored — never commit real keys.

# Admin password
ADMIN_PASSWORD=66666666

# ── AI trip planning pipeline (POST /trips) ──────────────────────────────────

# LLM provider: "gemini" (default) or "anthropic"
TRIP_LLM_PROVIDER=gemini

# Required when TRIP_LLM_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required when TRIP_LLM_PROVIDER=anthropic
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults per provider:
#   gemini    -> gemini-flash-latest
#   anthropic -> claude-opus-4-8
# Example: TRIP_MODEL=gemini-3.1-pro-preview
TRIP_MODEL=

# Set true to finish jobs with a labeled sample itinerary and skip search,
# crawl, and the LLM. Use this to try the UI before you have an API key.
TRIP_DEMO_MODE=false

# Public POST /trips. Set false to keep gallery and job reads open while
# refusing new plans. TRIP_CREATE_LIMIT is accepted creates per client address
# per TRIP_CREATE_WINDOW_MS (default 5 per hour). 0 disables the cap.
# The counter lives in the backend process and resets on restart.
TRIP_PUBLIC_CREATE=true
TRIP_CREATE_LIMIT=5
TRIP_CREATE_WINDOW_MS=3600000

# Optional tuning
# Number of web pages to collect per trip job (default: 30)
TRIP_TARGET_DOCUMENTS=30
# Parallel page fetches while crawling (default: 5)
TRIP_CRAWL_CONCURRENCY=5

